# Copy to .env and fill in. .env is gitignored.
# In AWS the key comes from SSM Parameter Store instead (see SCOUT_SSM_API_FOOTBALL_KEY).

# API Football key (dashboard.api-football.com). Required for feasibility and backfill.
API_FOOTBALL_KEY=

# Optional: SSM parameter name to read the key from when the env var is empty.
# SCOUT_SSM_API_FOOTBALL_KEY=/scout/api-football/key
# AWS_REGION=eu-central-1

# Claude API key (console.anthropic.com): the written reports (scout reports),
# the chat's deploy (passed as a NoEcho stack parameter, never written to a
# file) and its evaluation (scout chat-eval). Optional for everything else.
ANTHROPIC_API_KEY=
# In a Claude Code cloud session ANTHROPIC_API_KEY never reaches the shell
# (reserved for the session's sign in): the chat's deploy and evaluation read
# this name instead.
SCOUT_CHAT_CLAUDE_KEY=
